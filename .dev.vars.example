# Local secrets. Copy to .dev.vars (gitignored). Leave a key empty to run that step in deterministic MOCK mode.
# Pinterest session cookie (_pinterest_sess), written to a 0600 jar in out/ for each run. Safari: Develop > Show Web Inspector > Storage > Cookies > pinterest.com.
PINTEREST_SESS=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
